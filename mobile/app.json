{
  "expo": {
    "name": "Messenger",
    "slug": "messengerFront",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aliyeffali.messenger",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aliyeffali.lojamessenger",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "eas": {
        "projectId": "b3057385-e982-4359-b7e8-61423bbdf35c"
      }
    },
    "owner": "aliyeffali7",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d4af37"
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Səsli mesaj yazmaq üçün mikrofona giriş lazımdır."
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tətbiqin kilidini üz ilə açmaq üçün."
        }
      ]
    ]
  }
}
